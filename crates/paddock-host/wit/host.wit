package paddock:host;

/// The app world: callbacks and `process`. Host services link their own
/// worlds below (`src/services`). A component may import any subset.
world paddock-app {
  include paddock:runtime/app@0.1.0;
}

/// The logging service's interfaces (`src/services/logging`).
world logging {
  import wasi:logging/logging@0.1.0-draft;
}

/// The config service's interfaces (`src/services/config`).
world config {
  import wasi:config/store@0.2.0-rc.1;
}

/// The keyvalue service's interfaces (`src/services/keyvalue`).
world keyvalue {
  import wasi:keyvalue/store@0.2.0-draft;
  import wasi:keyvalue/atomics@0.2.0-draft;
  import wasi:keyvalue/batch@0.2.0-draft;
  import paddock:watch/watch@0.1.0;
}

/// The metrics service's interfaces (`src/services/metrics`).
world metrics {
  import paddock:metrics/metrics@0.1.0;
}

/// The secrets service's interfaces (`src/services/secrets`).
world secrets {
  import paddock:secrets/store@0.1.0;
}

/// The groups service's interfaces (`src/services/groups`).
world groups {
  import paddock:groups/groups@0.1.0;
}
