package paddock:host;

/// The app world and the host services Paddock has not yet moved to their
/// own world (`src/services`). A component may import any subset.
world paddock-app {
  include paddock:runtime/app@0.1.0;
  import wasi:config/store@0.2.0-rc.1;
  import wasi:keyvalue/store@0.2.0-draft;
  import wasi:keyvalue/atomics@0.2.0-draft;
  import wasi:keyvalue/batch@0.2.0-draft;
}

/// The logging service's interfaces (`src/services/logging`).
world logging {
  import wasi:logging/logging@0.1.0-draft;
}
