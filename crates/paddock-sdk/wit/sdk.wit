package paddock:sdk;

/// The world the SDK binds: the app world plus the host services the SDK
/// wraps. A component imports only what its code calls, so an app that
/// never opens a bucket has no `wasi:keyvalue` import.
world app {
  include paddock:runtime/app@0.1.0;
  import wasi:logging/logging@0.1.0-draft;
  import wasi:config/store@0.2.0-rc.1;
  import wasi:keyvalue/store@0.2.0-draft;
  import wasi:keyvalue/atomics@0.2.0-draft;
  import wasi:keyvalue/batch@0.2.0-draft;
  import paddock:groups/groups@0.1.0;
  import paddock:watch/watch@0.1.0;
  import paddock:secrets/store@0.1.0;
}

/// The world the SDK binds for connection handlers (feature `connection`):
/// one instance per connection accepted on the app's listeners.
world connection {
  include paddock:connection/connection-handler@0.1.0;
}
