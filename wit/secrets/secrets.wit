package paddock:secrets@0.1.0;

/// Secrets an operator binds on the node: passwords, keys, tokens. An app
/// lists the names it uses in its manifest (`capabilities."paddock:secrets"`),
/// the operator grants each name (policy `secrets`), and the node binds
/// each name to a source (`[secrets.<name>]`: a file or an environment
/// variable). The value is read on every call, so a rotated file is seen
/// at once; keep it out of snapshots and logs, and read it again when
/// needed.
interface store {
  /// Why a read failed.
  variant error {
    /// `paddock:secrets` is not granted, the manifest does not list the
    /// name, or the policy does not grant it.
    access-denied,
    /// The node binds no source for the name.
    not-found,
    /// The source could not be read (a missing file, an unset variable).
    unavailable(string),
  }

  /// The secret's value.
  get: func(name: string) -> result<list<u8>, error>;
}
