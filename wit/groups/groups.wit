package paddock:groups@0.1.0;

/// Process groups across the cluster, with publish, as OTP's `pg`.
/// Separate from `paddock:runtime` so the frozen app world does not change;
/// an app imports it only if it calls it.
///
/// Each node owns its members and tells the other nodes; membership is
/// eventual and never blocks. A node cut off from another stops listing
/// that node's members until they hear each other again.
///
/// An app declares the groups it may join and publish to in its manifest
/// (`capabilities."paddock:groups"`), and the operator grants the
/// capability. Every function returns `access-denied` without the grant, or
/// for a group the manifest does not list for that use.
interface groups {
  use paddock:runtime/types@0.1.0.{pid, envelope};

  /// Why a group operation failed.
  variant error {
    /// The capability is not granted, or the manifest does not list the
    /// group for this use (`join` for join and leave, `join` or `publish`
    /// for members, `publish` for publish).
    access-denied,
    /// Joining would exceed the instance's `limits.groups_max`.
    limit-reached,
  }

  /// Join a group. Joining a group the instance is in already does
  /// nothing. The instance leaves every group when it exits; an upgrade
  /// keeps its groups.
  join: func(group: string) -> result<_, error>;

  /// Leave a group. Leaving a group the instance is not in does nothing.
  leave: func(group: string) -> result<_, error>;

  /// The group's members on every node this node hears, ordered by pid.
  members: func(group: string) -> result<list<pid>, error>;

  /// Cast `msg` to every member, including the publisher if it is one, on
  /// any node; one copy goes to each other node with members, which fans it
  /// out. A member whose app's messaging ACL refuses the publisher's app,
  /// or whose app the publisher's `may_call` omits, is skipped. Returns how
  /// many members took it: on this node, those whose mailboxes did; on
  /// another node, all its members once the copy is sent (that node may
  /// still skip some). A member whose mailbox is full drops it and counts it
  /// as a dropped cast; a member whose `message_max_bytes` is smaller than
  /// the body does not receive it.
  publish: func(group: string, msg: envelope) -> result<u32, error>;
}
