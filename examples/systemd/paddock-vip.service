# Move a virtual IP to the primary of an HA pair (docs/OPERATIONS.md, "A
# virtual IP that follows the primary"). One per node of the pair, beside
# paddock.service. It runs as the paddock user, to read the admin socket,
# with the two capabilities moving an address needs; paddock.service keeps
# none of them.
#
# Install:
#   install -m 0755 examples/systemd/paddock-vip.sh /usr/local/bin/paddock-vip.sh
#   install -m 0644 examples/systemd/paddock-vip.service /etc/systemd/system/
#   systemctl edit paddock-vip     # set Environment=PADDOCK_VIP=... PADDOCK_VIP_DEV=...
#   systemctl daemon-reload && systemctl enable --now paddock-vip

[Unit]
Description=Virtual IP following the Paddock primary
After=paddock.service
BindsTo=paddock.service

[Service]
Type=exec
User=paddock
Group=paddock
Environment=PADDOCK_SOCKET=/var/lib/paddock/admin.sock
Environment=PADDOCK_VIP=10.0.0.10/24
Environment=PADDOCK_VIP_DEV=eth0
ExecStart=/usr/local/bin/paddock-vip.sh ${PADDOCK_VIP} ${PADDOCK_VIP_DEV}
Restart=always
RestartSec=2

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
