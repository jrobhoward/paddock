# Bulkhead under its privileged helper (OPERATIONS.md, "The privileged
# helper"). systemd starts bulkhead-priv as root; it starts the node as
# the node's user and every app instance under a user of the app's own.
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin bulkhead
#   install -m 0755 target/release/bulkhead-priv /usr/local/sbin/bulkhead-priv
#   install -m 0755 target/release/bulkhead /usr/local/bin/bulkhead
#   install -D -m 0755 target/release/bulkhead-runner /usr/local/libexec/bulkhead/bulkhead-runner
#   install -d -m 0700 -o bulkhead -g bulkhead /var/lib/bulkhead
#   install -m 0600 examples/systemd/priv.conf /etc/bulkhead/priv.conf   # then edit node_uid, node_gid
#   install -m 0644 examples/systemd/bulkhead-priv.service /etc/systemd/system/bulkhead.service
#   systemctl daemon-reload && systemctl enable --now bulkhead
#
# node.toml sets [priv] and leaves [native] cgroup unset. In place of
# bulkhead.service (the node started directly), not beside it.
[Unit]
Description=Bulkhead node, under its privileged helper
Documentation=https://github.com/jrobhoward/bulkhead/blob/main/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/bulkhead-priv /etc/bulkhead/priv.conf
# The helper passes SIGHUP to the node (node config reload) and SIGTERM
# too; the node stops its apps and exits, then the helper does. Only the
# helper gets the signal: the node and the apps are left to it, and
# killed if anything is left after the timeout.
ExecReload=/bin/kill -HUP $MAINPID
KillMode=mixed
TimeoutStopSec=60
Restart=on-failure
RestartSec=2
# The helper makes a cgroup per instance under this service's own (its
# configuration's `cgroup` is /sys/fs/cgroup/system.slice/bulkhead.service).
Delegate=yes
# What costs the helper nothing, and so holds for the node and the apps
# it starts too. Not ProtectControlGroups or ProtectKernelTunables (the
# helper writes its cgroups), ProtectHostname (an instance sets its own
# host name, in its UTS namespace), RestrictNamespaces (its seccomp filter
# cannot read clone3's flags, so it makes clone3 fail with ENOSYS, and the
# helper starts each instance with clone3), or RestrictSUIDSGID (a shared
# volume's directory gets the set-group-id bit).
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_KILL CAP_SETGID CAP_SETUID CAP_NET_BIND_SERVICE CAP_SYS_ADMIN
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
