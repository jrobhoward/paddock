# A Paddock node as a systemd service (docs/OPERATIONS.md).
#
# Install:
#   useradd --system --no-create-home --shell /usr/sbin/nologin paddock
#   install -m 0755 target/release/paddock /usr/local/bin/paddock
#   install -d -m 0750 -o root -g paddock /etc/paddock     # node.toml, policy, keys
#   install -m 0644 examples/systemd/paddock.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now paddock
#
# node.toml: data_dir = "/var/lib/paddock" (StateDirectory below creates it).
# Admin commands run as the paddock user, or another with access to
# /var/lib/paddock/admin.sock (mode 0600): sudo -u paddock paddock list

[Unit]
Description=Paddock node
Documentation=https://github.com/jrobhoward/paddock/blob/main/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=paddock
Group=paddock
ExecStart=/usr/local/bin/paddock node --config /etc/paddock/node.toml
# Reload HTTPS certificates and the cluster key and peers file.
ExecReload=/bin/kill -HUP $MAINPID
# Apps stop in reverse start order on SIGTERM.
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

# data_dir, owned by the service user.
StateDirectory=paddock
StateDirectoryMode=0750

# Privileges: none but binding ports below 1024 (ingress, listeners). Remove
# both lines if every port is 1024 or above.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Serial lines (Modbus RTU, the failover serial heartbeat): uncomment, and
# remove PrivateDevices below, which hides /dev/tty*.
#SupplementaryGroups=dialout

# Sandboxing. Not MemoryDenyWriteExecute: wasmtime compiles guest code at
# run time. Not LimitAS: each instance reserves gigabytes of address space.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Volumes outside data_dir that apps write ([volumes] in node.toml):
#ReadWritePaths=/srv/paddock/volumes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
