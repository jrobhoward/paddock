# Move a virtual IP to the primary of an HA pair (docs/OPERATIONS.md, "A
# virtual IP that follows the primary"). One per node of the pair, beside
# bulkhead.service. It runs as the bulkhead user, to read the admin socket,
# with the two capabilities moving an address needs; bulkhead.service keeps
# none of them.
#
# Install:
#   install -m 0755 examples/systemd/bulkhead-vip.sh /usr/local/bin/bulkhead-vip.sh
#   install -m 0644 examples/systemd/bulkhead-vip.service /etc/systemd/system/
#   systemctl edit bulkhead-vip     # set Environment=BULKHEAD_VIP=... BULKHEAD_VIP_DEV=...
#   systemctl daemon-reload && systemctl enable --now bulkhead-vip

[Unit]
Description=Virtual IP following the Bulkhead primary
After=bulkhead.service
BindsTo=bulkhead.service

[Service]
Type=exec
User=bulkhead
Group=bulkhead
Environment=BULKHEAD_SOCKET=/var/lib/bulkhead/admin.sock
Environment=BULKHEAD_VIP=10.0.0.10/24
Environment=BULKHEAD_VIP_DEV=eth0
ExecStart=/usr/local/bin/bulkhead-vip.sh ${BULKHEAD_VIP} ${BULKHEAD_VIP_DEV}
Restart=always
RestartSec=2

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
