# A Bulkhead node as a systemd service (docs/OPERATIONS.md).
#
# Install:
#   useradd --system --no-create-home --shell /usr/sbin/nologin bulkhead
#   install -m 0755 target/release/bulkhead /usr/local/bin/bulkhead
#   install -m 0755 target/release/bulkhead-runner /usr/local/bin/bulkhead-runner  # native-process apps
#   install -d -m 0750 -o root -g bulkhead /etc/bulkhead     # node.toml, policy, keys
#   install -m 0644 examples/systemd/bulkhead.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now bulkhead
#
# node.toml: data_dir = "/var/lib/bulkhead" (StateDirectory below creates it).
# Admin commands run as the bulkhead user, or another with access to
# /var/lib/bulkhead/admin.sock (mode 0600): sudo -u bulkhead bulkhead list

[Unit]
Description=Bulkhead node
Documentation=https://github.com/jrobhoward/bulkhead/blob/main/docs/OPERATIONS.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=bulkhead
Group=bulkhead
ExecStart=/usr/local/bin/bulkhead node --config /etc/bulkhead/node.toml
# Reload HTTPS certificates, the cluster key and peers file, and the remote
# admin operators file.
ExecReload=/bin/kill -HUP $MAINPID
# Apps stop in reverse start order on SIGTERM.
TimeoutStopSec=30
Restart=on-failure
RestartSec=2

# data_dir, owned by the service user.
StateDirectory=bulkhead
StateDirectoryMode=0750

# Privileges: none but binding ports below 1024 (ingress, listeners). Remove
# both lines if every port is 1024 or above.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
# Serial lines (the failover serial heartbeat): uncomment, and
# remove PrivateDevices below, which hides /dev/tty*.
#SupplementaryGroups=dialout

# Sandboxing. Not MemoryDenyWriteExecute: wasmtime compiles guest code at
# run time. Not LimitAS: each instance reserves gigabytes of address space.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
# Native-process apps' memory and process limits ([native] cgroup): replace
# with Delegate=yes.
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Volumes outside data_dir that apps write ([volumes] in node.toml):
#ReadWritePaths=/srv/bulkhead/volumes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
