diff --git a/crates/paddock-host/src/s24_interrupter.rs b/crates/paddock-host/src/s24_interrupter.rs
new file mode 100644
index 0000000..1087058
--- /dev/null
+++ b/crates/paddock-host/src/s24_interrupter.rs
@@ -0,0 +1,156 @@
+//! Spike S24: an `MmuInterrupter` with one interrupt page per thread and
+//! generation, so a fiber resume takes no lock, touches no shared atomic
+//! and allocates nothing.
+//!
+//! wasmtime's `TimingWheelInterrupter` locks a slot and bumps a shared
+//! refcount on every resume, which `pool_load` at 16 workers showed as a
+//! third of the empty-call throughput lost. This interrupter keeps the
+//! epoch ticker's meaning instead: every running guest is interrupted at
+//! the next tick.
+//!
+//! Two generations of `SLOTS` pages, contiguous. A store takes its thread's
+//! page in the current generation. A tick unprotects the other generation,
+//! makes it current, and protects the old one with a single `mprotect`. A
+//! store that still holds an old page when that generation is unprotected
+//! again (one in a long synchronous host call) is interrupted a tick later.
+
+use std::cell::Cell;
+use std::ffi::c_void;
+use std::ptr::NonNull;
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use rustix::mm::{MapFlags, MprotectFlags, ProtFlags, mmap_anonymous, mprotect, munmap};
+use wasmtime::{MmuInterrupter, PageHandle};
+
+/// Pages per generation; threads past this share pages, which is harmless.
+const SLOTS: usize = 256;
+
+thread_local! {
+    static SLOT: Cell<Option<usize>> = const { Cell::new(None) };
+    static CURRENT: Cell<usize> = const { Cell::new(0) };
+}
+
+pub(crate) struct PerThreadInterrupter {
+    base: NonNull<u8>,
+    page: usize,
+    generation: AtomicUsize,
+    next_slot: AtomicUsize,
+}
+
+// SAFETY: `base` is a mapping owned by this value and only read or
+// protected through syscalls, never dereferenced from Rust.
+unsafe impl Send for PerThreadInterrupter {}
+// SAFETY: as above; all mutable state is atomic.
+unsafe impl Sync for PerThreadInterrupter {}
+
+impl PerThreadInterrupter {
+    pub(crate) fn new() -> std::io::Result<Self> {
+        let page = rustix::param::page_size();
+        // SAFETY: a null hint lets the kernel choose the address.
+        let ptr = unsafe {
+            mmap_anonymous(
+                std::ptr::null_mut(),
+                2 * SLOTS * page,
+                ProtFlags::READ,
+                MapFlags::PRIVATE,
+            )
+        }?;
+        let base = NonNull::new(ptr.cast::<u8>()).ok_or(std::io::ErrorKind::Other)?;
+        Ok(Self {
+            base,
+            page,
+            generation: AtomicUsize::new(0),
+            next_slot: AtomicUsize::new(0),
+        })
+    }
+
+    fn range(&self, generation: usize) -> *mut c_void {
+        // SAFETY: inside the mapping: generation is 0 or 1.
+        unsafe { self.base.as_ptr().add(generation * SLOTS * self.page) }.cast()
+    }
+
+    fn protect(&self, generation: usize, flags: MprotectFlags) {
+        // SAFETY: the range is one generation of this value's own mapping.
+        if let Err(e) = unsafe { mprotect(self.range(generation), SLOTS * self.page, flags) } {
+            tracing::error!(%e, "S24: cannot change an interrupt page's protection");
+        }
+    }
+
+    /// Interrupt every store running now; called by the ticker thread only.
+    pub(crate) fn tick(&self) {
+        let old = self.generation.load(Ordering::Relaxed);
+        let new = 1 - old;
+        self.protect(new, MprotectFlags::READ);
+        self.generation.store(new, Ordering::Release);
+        self.protect(old, MprotectFlags::empty());
+    }
+}
+
+impl Drop for PerThreadInterrupter {
+    fn drop(&mut self) {
+        // SAFETY: the engine that loaded from these pages owned this value
+        // and is gone.
+        let _ = unsafe { munmap(self.base.as_ptr().cast(), 2 * SLOTS * self.page) };
+    }
+}
+
+/// Zero-sized, so the `Box` wasmtime asks for allocates nothing; the page
+/// is the one `acquire_page` chose on this thread, read back at once.
+struct Handle;
+
+impl PageHandle for Handle {
+    fn page_ptr(&self) -> NonNull<c_void> {
+        let addr = CURRENT.with(Cell::get);
+        NonNull::new(addr as *mut c_void).unwrap_or(NonNull::dangling())
+    }
+}
+
+impl MmuInterrupter for PerThreadInterrupter {
+    fn acquire_page(&self) -> Box<dyn PageHandle> {
+        let slot = SLOT.with(|s| {
+            s.get().unwrap_or_else(|| {
+                let n = self.next_slot.fetch_add(1, Ordering::Relaxed) % SLOTS;
+                s.set(Some(n));
+                n
+            })
+        });
+        let generation = self.generation.load(Ordering::Acquire);
+        let addr = self.base.as_ptr() as usize + (generation * SLOTS + slot) * self.page;
+        CURRENT.with(|c| c.set(addr));
+        Box::new(Handle)
+    }
+}
+
+/// The interrupter a spike engine runs with, and how the ticker drives it.
+pub(crate) enum Interrupter {
+    Wheel(std::sync::Arc<wasmtime::TimingWheelInterrupter>),
+    Thread(std::sync::Arc<PerThreadInterrupter>),
+}
+
+impl Interrupter {
+    /// `PADDOCK_S24_INTERRUPTER=thread` for [`PerThreadInterrupter`],
+    /// otherwise wasmtime's timing wheel ticked every tick.
+    pub(crate) fn from_env() -> std::io::Result<Self> {
+        Ok(
+            if std::env::var_os("PADDOCK_S24_INTERRUPTER").is_some_and(|v| v == "thread") {
+                Self::Thread(std::sync::Arc::new(PerThreadInterrupter::new()?))
+            } else {
+                Self::Wheel(std::sync::Arc::new(wasmtime::TimingWheelInterrupter::new(0)))
+            },
+        )
+    }
+
+    pub(crate) fn as_dyn(&self) -> std::sync::Arc<dyn MmuInterrupter> {
+        match self {
+            Self::Wheel(w) => w.clone(),
+            Self::Thread(t) => t.clone(),
+        }
+    }
+
+    pub(crate) fn tick(&self) {
+        match self {
+            Self::Wheel(w) => w.tick(),
+            Self::Thread(t) => t.tick(),
+        }
+    }
+}
